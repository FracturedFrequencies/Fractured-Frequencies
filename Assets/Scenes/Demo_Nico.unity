MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 397105948}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 079893e4b00859144b71dd8c3574287c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FracturedFrequencies.World.TutorialDirector
  player: {fileID: 1224106701}
  gravity: {fileID: 91486913}
  marker: {fileID: 667938722}
  steps:
  - instruction: Move with  W A S D
    hint: 
    hintDelay: 0
    highlight: {fileID: 0}
    highlightRadius: 1
    goal: 0
    distance: 2
    gravityDirection: {x: 0, y: 0, z: 0}
    chamber: {fileID: 0}
    door: {fileID: 0}
    breakTarget: {fileID: 0}
  - instruction: 'Pink crystals change gravity.

      Point at the crystal on the
      RIGHT WALL and LEFT CLICK it.'
    hint: It is the pink diamond inside the yellow ring.
    hintDelay: 8
    highlight: {fileID: 1026111545}
    highlightRadius: 1
    goal: 2
    distance: 0
    gravityDirection: {x: 1, y: 0, z: 0}
    chamber: {fileID: 0}
    door: {fileID: 0}
    breakTarget: {fileID: 0}
  - instruction: 'You are standing on the wall!

      Walk to the glowing crack
      and step into it.'
    hint: W walks up the wall. The crystal on the floor turns gravity back.
    hintDelay: 12
    highlight: {fileID: 1603187934}
    highlightRadius: 1.4
    goal: 3
    distance: 0
    gravityDirection: {x: 0, y: 0, z: 0}
    chamber: {fileID: 530730844}
    door: {fileID: 0}
    breakTarget: {fileID: 0}
  - instruction: 'A glass wall blocks the way.

      Point at it and HOLD the RIGHT
      mouse button until it shatters.'
    hint: Keep holding. The bar above the cursor fills up.
    hintDelay: 6
    highlight: {fileID: 2029134971}
    highlightRadius: 1.6
    goal: 6
    distance: 0
    gravityDirection: {x: 0, y: 0, z: 0}
    chamber: {fileID: 0}
    door: {fileID: 0}
    breakTarget: {fileID: 2029134967}
  - instruction: Step into the glowing crack.
    hint: 
    hintDelay: 0
    highlight: {fileID: 44826679}
    highlightRadius: 1.4
    goal: 3
    distance: 0
    gravityDirection: {x: 0, y: 0, z: 0}
    chamber: {fileID: 2099904163}
    door: {fileID: 0}
    breakTarget: {fileID: 0}
  - instruction: 'The exit is behind the CRACKED STONE in the right wall.

      Stone
      is too thick to resonate. Only something HEAVY falling hard breaks it.'
    hint: Shatter the glass in front of the iron crate (hold RIGHT click), then LEFT
      CLICK the crystal on the right wall. Let the crate fall!
    hintDelay: 15
    highlight: {fileID: 1452996526}
    highlightRadius: 1.5
    goal: 6
    distance: 0
    gravityDirection: {x: 0, y: 0, z: 0}
    chamber: {fileID: 0}
    door: {fileID: 0}
    breakTarget: {fileID: 1452996522}
  - instruction: 'The stone broke!

      Make the right wall the floor and walk
      into the glowing opening.'
    hint: Click the crystal on the right wall if you are still on the floor.
    hintDelay: 8
    highlight: {fileID: 661361909}
    highlightRadius: 1.4
    goal: 5
    distance: 0
    gravityDirection: {x: 0, y: 0, z: 0}
    chamber: {fileID: 0}
    door: {fileID: 0}
    breakTarget: {fileID: 0}
  completeText: 'Room 1 complete!

    Gravity, resonance and impact: you know all
    three.'
